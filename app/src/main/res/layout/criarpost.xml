<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/_app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay">
		<androidx.appcompat.widget.Toolbar
			android:id="@+id/_toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="?attr/colorPrimary"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</com.google.android.material.appbar.AppBarLayout>
	<RelativeLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#F8F9FA"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<ScrollView
			android:id="@+id/vscrollCriar"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_above="@id/bottom_nav">
			<LinearLayout
				android:id="@+id/linear23"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="16dp"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear24"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="20dp"
					android:background="#FFFFFF"
					android:orientation="vertical"
					android:elevation="2dp">
					<TextView
						android:id="@+id/textview35"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Criar Publicação ✍️"
						android:textSize="18sp"
						android:textStyle="bold"
						android:textColor="#222222" />
					<TextView
						android:id="@+id/textview36"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:text="O que está a acontecer no caldeirão\?"
						android:textSize="13sp"
						android:textColor="#666666" />
					<EditText
						android:id="@+id/edTitulo"
						android:layout_width="match_parent"
						android:layout_height="140dp"
						android:layout_marginTop="16dp"
						android:padding="12dp"
						android:background="#F1F3F4"
						android:textSize="14sp"
						android:textColor="#222222"
						android:hint="Escreve o teu post aqui... 🍮"
						android:textColorHint="#888888"
						android:gravity="top|start"
						android:inputType="textMultiLine" />
					<CheckBox
						android:id="@+id/checkDdlAd"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="Destacar como anúncio 📢"
						android:textSize="13sp"
						android:textColor="#444444" />
					<CheckBox
						android:id="@+id/checkAnon"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:text="Publicar anonimamente (\@anon) 🕵️"
						android:textSize="13sp"
						android:textColor="#444444" />
					<Button
						android:id="@+id/btnPublicar"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="16dp"
						android:background="#795548"
						android:text="Publicar Post 🍮"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF"
						android:textAllCaps="false" />
				</LinearLayout>
			</LinearLayout>
		</ScrollView>
		<LinearLayout
			android:id="@+id/bottom_nav"
			android:layout_width="match_parent"
			android:layout_height="56dp"
			android:background="#FFFFFF"
			android:orientation="horizontal"
			android:weightSum="3"
			android:elevation="8dp"
			android:layout_alignParentBottom="true">
			<LinearLayout
				android:id="@+id/nav_feed"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:layout_weight="1"
				android:alpha="0.5"
				android:focusable="true">
				<TextView
					android:id="@+id/textview37"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="🏠"
					android:textSize="18sp" />
				<TextView
					android:id="@+id/textview38"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Feed"
					android:textSize="12sp"
					android:textColor="#795548" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/nav_criar"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:layout_weight="1"
				android:alpha="1.0"
				android:focusable="true">
				<TextView
					android:id="@+id/textview39"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="➕"
					android:textSize="18sp" />
				<TextView
					android:id="@+id/textview40"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Criar"
					android:textSize="12sp"
					android:textStyle="bold"
					android:textColor="#795548" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/nav_perfil"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:layout_weight="1"
				android:alpha="0.5"
				android:focusable="true">
				<TextView
					android:id="@+id/textview41"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="👤"
					android:textSize="18sp" />
				<TextView
					android:id="@+id/textview42"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Perfil"
					android:textSize="12sp"
					android:textColor="#795548" />
			</LinearLayout>
		</LinearLayout>
	</RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
